-- Tabelas Principais (Entidades Fortes)

CREATE TABLE RESPONSAVEL (
    CPF VARCHAR(14) PRIMARY KEY,
    Nome VARCHAR(255) NOT NULL,
    Telefone VARCHAR(20),
    Endereco VARCHAR(255)
);

CREATE TABLE ALUNO (
    CPF VARCHAR(14) PRIMARY KEY,
    Nome VARCHAR(255) NOT NULL,
    Data_Nasc DATE,
    Endereco VARCHAR(255),
    Escolaridade VARCHAR(100)
);

CREATE TABLE DISCIPLINA (
    Cod VARCHAR(50) PRIMARY KEY,
    Nome VARCHAR(255) NOT NULL
);

CREATE TABLE FUNCIONARIO (
    CPF VARCHAR(14) PRIMARY KEY,
    Nome VARCHAR(255) NOT NULL,
    Endereco VARCHAR(255),
    Senha_Hash VARCHAR(255) NOT NULL,
    Ativo BOOLEAN DEFAULT TRUE
);

CREATE TABLE ATIVIDADE (
    Cod VARCHAR(50) PRIMARY KEY,
    Nome VARCHAR(255) NOT NULL,
    Local_Atividade VARCHAR(255),
    Periodo VARCHAR(100)
);

-- Tabelas de Atributos Multivalorados
CREATE TABLE ALUNO_INTERESSE (
    CPF_Aluno VARCHAR(14),
    Interesse VARCHAR(100),
    PRIMARY KEY (CPF_Aluno, Interesse),
    FOREIGN KEY (CPF_Aluno) REFERENCES ALUNO(CPF) ON DELETE CASCADE
);

CREATE TABLE ALUNO_NECESSIDADE (
    CPF_Aluno VARCHAR(14),
    Cuidado_Especial VARCHAR(255),
    PRIMARY KEY (CPF_Aluno, Cuidado_Especial),
    FOREIGN KEY (CPF_Aluno) REFERENCES ALUNO(CPF) ON DELETE CASCADE
);

CREATE TABLE FUNCIONARIO_TELEFONE (
    CPF_Funcionario VARCHAR(14),
    Telefone VARCHAR(20),
    PRIMARY KEY (CPF_Funcionario, Telefone),
    FOREIGN KEY (CPF_Funcionario) REFERENCES FUNCIONARIO(CPF) ON DELETE CASCADE
);

CREATE TABLE FUNCIONARIO_DISPONIBILIDADE (
    CPF_Funcionario VARCHAR(14),
    Disponibilidade VARCHAR(100),
    PRIMARY KEY (CPF_Funcionario, Disponibilidade),
    FOREIGN KEY (CPF_Funcionario) REFERENCES FUNCIONARIO(CPF) ON DELETE CASCADE
);

CREATE TABLE ATIVIDADE_MATERIAL (
    Cod_Atividade VARCHAR(50),
    Material VARCHAR(100),
    PRIMARY KEY (Cod_Atividade, Material),
    FOREIGN KEY (Cod_Atividade) REFERENCES ATIVIDADE(Cod) ON DELETE CASCADE
);

-- Subclasses de Funcionário
CREATE TABLE PROFESSOR (
    CPF_Funcionario VARCHAR(14) PRIMARY KEY,
    FOREIGN KEY (CPF_Funcionario) REFERENCES FUNCIONARIO(CPF) ON DELETE CASCADE
);

CREATE TABLE COORDENADOR (
    CPF_Funcionario VARCHAR(14) PRIMARY KEY,
    FOREIGN KEY (CPF_Funcionario) REFERENCES FUNCIONARIO(CPF) ON DELETE CASCADE
);

CREATE TABLE RECREADOR (
    CPF_Funcionario VARCHAR(14) PRIMARY KEY,
    FOREIGN KEY (CPF_Funcionario) REFERENCES FUNCIONARIO(CPF) ON DELETE CASCADE
);

-- Tabelas de Relacionamentos
CREATE TABLE POSSUI_RESP_ALUNO (
    CPF_Responsavel VARCHAR(14),
    CPF_Aluno VARCHAR(14),
    PRIMARY KEY (CPF_Responsavel, CPF_Aluno),
    FOREIGN KEY (CPF_Responsavel) REFERENCES RESPONSAVEL(CPF) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Aluno) REFERENCES ALUNO(CPF) ON DELETE CASCADE
);

CREATE TABLE MATRICULA (
    CPF_Aluno VARCHAR(14),
    Cod_Disciplina VARCHAR(50),
    Nota_Recebida DECIMAL(5,2),
    PRIMARY KEY (CPF_Aluno, Cod_Disciplina),
    FOREIGN KEY (CPF_Aluno) REFERENCES ALUNO(CPF) ON DELETE CASCADE,
    FOREIGN KEY (Cod_Disciplina) REFERENCES DISCIPLINA(Cod) ON DELETE CASCADE
);

CREATE TABLE OFERECIMENTO (
    Cod_Disciplina VARCHAR(50) NOT NULL,
    Data_Inicio DATE,
    Data_Fim DATE,
    Hora_Inicio TIME,
    PRIMARY KEY (Cod_Disciplina, Data_Inicio, Data_Fim),
    FOREIGN KEY (Cod_Disciplina) REFERENCES DISCIPLINA(Cod) ON DELETE CASCADE
);

CREATE TABLE PARTICIPACAO (
    CPF_Aluno VARCHAR(14),
    Cod_Atividade VARCHAR(50),
    Girassol_Recebido INT,
    PRIMARY KEY (CPF_Aluno, Cod_Atividade),
    FOREIGN KEY (CPF_Aluno) REFERENCES ALUNO(CPF) ON DELETE CASCADE,
    FOREIGN KEY (Cod_Atividade) REFERENCES ATIVIDADE(Cod) ON DELETE CASCADE
);

CREATE TABLE MINISTRA_OFERECIMENTO (
    Cod_Disciplina VARCHAR(50) NOT NULL,
    Data_Inicio DATE NOT NULL,
    Data_Fim DATE NOT NULL,
    CPF_Professor VARCHAR(14) NOT NULL,
    PRIMARY KEY (Cod_Disciplina, Data_Inicio, Data_Fim, CPF_Professor),
    FOREIGN KEY (Cod_Disciplina, Data_Inicio, Data_Fim) REFERENCES OFERECIMENTO(Cod_Disciplina, Data_Inicio, Data_Fim) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Professor) REFERENCES PROFESSOR(CPF_Funcionario) ON DELETE CASCADE
);

CREATE TABLE MINISTRA_ATIVIDADE (
    Cod_Atividade VARCHAR(50),
    CPF_Recreador VARCHAR(14),
    Data_Atividade DATE,
    Horario TIME,
    PRIMARY KEY (Cod_Atividade, CPF_Recreador, Data_Atividade, Horario),
    FOREIGN KEY (Cod_Atividade) REFERENCES ATIVIDADE(Cod) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Recreador) REFERENCES RECREADOR(CPF_Funcionario) ON DELETE CASCADE
);

CREATE TABLE AVALIA_PROFESSOR (
    CPF_Coordenador VARCHAR(14),
    CPF_Professor VARCHAR(14),
	Data_Avaliacao DATE,
    Nota_Recebida DECIMAL(5,2),
    PRIMARY KEY (CPF_Coordenador, CPF_Professor, Data_Avaliacao),
    FOREIGN KEY (CPF_Coordenador) REFERENCES COORDENADOR(CPF_Funcionario) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Professor) REFERENCES PROFESSOR(CPF_Funcionario) ON DELETE CASCADE
);

CREATE TABLE AVALIA_RECREADOR (
    CPF_Coordenador VARCHAR(14),
    CPF_Recreador VARCHAR(14),
    Cod_Atividade VARCHAR(50),
    Data_Avaliacao DATE,
    Nota_recebida DECIMAL(5,2),
    PRIMARY KEY (CPF_Coordenador, CPF_Recreador, Cod_Atividade, Data_Avaliacao),
    FOREIGN KEY (CPF_Coordenador) REFERENCES COORDENADOR(CPF_Funcionario) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Recreador) REFERENCES RECREADOR(CPF_Funcionario) ON DELETE CASCADE,
    FOREIGN KEY (Cod_Atividade) REFERENCES ATIVIDADE(Cod) ON DELETE CASCADE
);

CREATE TABLE CONTATO (
    CPF_Coordenador VARCHAR(14),
    CPF_Responsavel VARCHAR(14),
    Motivo VARCHAR(255),
    PRIMARY KEY (CPF_Coordenador, CPF_Responsavel),
    FOREIGN KEY (CPF_Coordenador) REFERENCES COORDENADOR(CPF_Funcionario) ON DELETE CASCADE,
    FOREIGN KEY (CPF_Responsavel) REFERENCES RESPONSAVEL(CPF) ON DELETE CASCADE
);